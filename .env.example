# GajRaksha - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.

# Movebank credentials and study ID
MOVEBANK_USER=your_username_here
MOVEBANK_PASS=your_password_here
STUDY_ID=736029750

# Region and Timezone Configuration (kruger -> Africa/Johannesburg, india -> Asia/Kolkata)
REGION=kruger
TIMEZONE=Africa/Johannesburg

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
