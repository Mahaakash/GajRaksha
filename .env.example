# GajRaksha - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.

# Movebank credentials (optional if using public datasets or pre-downloaded study)
MOVEBANK_USERNAME=your_username_here
MOVEBANK_PASSWORD=your_password_here

# FastAPI Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
